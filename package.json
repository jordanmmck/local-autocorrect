{
  "name": "autocorrect-monorepo",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "tsc -p packages/core && tsc -p apps/vscode && tsc -p apps/macos",
    "test": "npm test --workspaces",
    "bench": "npm run build -w @autocorrect/core && node benchmarks/run.mts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
